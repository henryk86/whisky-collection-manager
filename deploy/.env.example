# Docker Compose liest die Datei .env im Projektstamm automatisch ein.
# Beim ersten Aufruf von sh deploy/setup-pi.sh wird diese Vorlage nach .env kopiert.
IMAGE_TAG=latest
TZ=Europe/Berlin

# DNS-Namen fuer das HTTPS-Zertifikat (kommagetrennt, ohne URL-Schema oder Port).
# Zusätzliche Namen können ergänzt oder bestehende entfernt werden.
CERT_DNS_NAMES=home-pi,home-pi.local,whisky-pi.local,raspberrypi.local,localhost

# IPv4-Adressen fuer das HTTPS-Zertifikat (Pi-IP anpassen).
# localhost und 127.0.0.1 sind fuer den internen Backup-Prozess immer enthalten.
CERT_IP_ADDRESSES=127.0.0.1,192.168.178.40

# Optional: geocoding provider for individual searches triggered in the map UI.
# No automated/bulk requests; keep the OSM public-service usage policy in mind.
OSM_GEOCODING_URL=https://nominatim.openstreetmap.org/search

# WCM_DATA_DIR wird bei setup-pi.sh als absoluter Pfad außerhalb des Git-Checkouts ergänzt.

# Vor dem Upgrade die wirklich genutzten LAN-/Router-Namen und IPs pruefen:
# unbekannte Hosts erhalten HTTP 421 (Diagnose: docker compose logs app).
# Reverse Proxy: Upstream muss HTTPS sprechen und den Host-Header beibehalten.
# TLS-Terminierung am Proxy mit HTTP-Upstream wird nicht unterstuetzt (403 fuer Writes).
# Optional: additional permitted HTTP Host values, e.g. when using an HTTPS upstream proxy.
# By default localhost/127.0.0.1/::1 and certificate DNS/IP names are permitted.
# Do not use '*'; explicitly list each additional name or IP.
# ALLOWED_HOSTS=whisky.example.local

# Optional: restrict Chrome/Edge image-import CORS to your own extension IDs.
# Leave empty to preserve the previous behavior (any valid Chrome extension ID).
# EXTENSION_IDS=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

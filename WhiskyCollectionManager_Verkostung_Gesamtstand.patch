+.tasting-summary-notes { display:grid; gap:14px; flex:1 1 235px; min-width:0; }
+.tasting-summary-note { min-width:0; }
+.tasting-summary-note-value { font-weight:650; margin-top:4px; line-height:1.45; overflow:hidden; display:-webkit-box;
+    -webkit-box-orient:vertical; -webkit-line-clamp:2; line-clamp:2; overflow-wrap:anywhere; white-space:pre-line; }
+/* Most bottlings have no tastings: show a quiet hint in the section header,

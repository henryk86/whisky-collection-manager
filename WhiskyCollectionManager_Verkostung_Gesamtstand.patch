+.tasting-summary-field-label { display:block; color:var(--muted); font-size:12px; font-weight:400; }
+.tasting-summary-meta { font-size:13px; }
+.tasting-summary-actions { flex:0 0 auto; justify-content:flex-end; }
+.tasting-summary-body { display:flex; align-items:center; justify-content:flex-start; flex-wrap:wrap; gap:16px 28px; margin-top:12px; min-width:0; }
+.tasting-summary-score { display:flex; align-items:center; flex-wrap:wrap; gap:6px 13px; flex:0 0 auto; min-width:0; }

 .tasting-summary-rating { font-size:clamp(1.3rem,2.5vw,1.85rem); font-weight:750; margin:0; white-space:nowrap; font-variant-numeric:tabular-nums; }
+.tasting-summary-radar { flex:0 1 310px; min-width:230px; }
+.tasting-summary-radar .flavor-editor.is-preview { display:block; }

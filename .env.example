# HTTP (standardmaessig deaktiviert)
PORT=3100
HOST=0.0.0.0
WHISKY_DATA_DIR=.
HTTP_ENABLED=false

# HTTPS (npm run https:setup -- --ip <LAPTOP-IP>)
HTTPS_ENABLED=true
HTTPS_PORT=3543
HTTPS_CERT_FILE=certs/server-cert.pem
HTTPS_KEY_FILE=certs/server-key.pem

# Allowed request hosts: loopback + certificate names by default.
# Existing installations: ensure the actual LAN-IP or router hostname is allowed (else HTTP 421).
# Reverse proxies must forward HTTPS to this app and preserve Host; HTTP upstream writes return 403.
# To add more DNS/IP values, specify them comma-separated.
# ALLOWED_HOSTS=whisky.example.local
# Optional list of trusted Chrome/Edge extension IDs for image staging.
# EXTENSION_IDS=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa

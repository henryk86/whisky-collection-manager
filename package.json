{
  "name": "whisky-collection-manager",
  "version": "1.14.0",
  "private": true,
  "description": "Lokale Whisky-Sammlungsverwaltung mit JSON-Datenspeicherung",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node --watch server/index.js",
    "auth:reset-admin": "node scripts/reset-admin-password.js",
    "https:setup": "node scripts/setup-https.js",
    "test": "node scripts/test.js",
    "test:browser": "node scripts/test.js --browser",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test",
    "release:check": "node scripts/release-version.js check",
    "hooks:install": "node scripts/install-git-hooks.js",
    "upgrade:audit": "node scripts/upgrade-manifest.js",
    "release:sync": "node scripts/release-version.js sync",
    "release:bump": "node scripts/release-version.js bump",
    "cutout:prepare": "node scripts/prepare-cutout-assets.js",
    "cutout:verify": "node scripts/prepare-cutout-assets.js --verify",
    "offline:verify": "node scripts/offline-bundle.js verify && node scripts/prepare-cutout-assets.js --verify",
    "test:visual": "node scripts/designsystem-visual.js --capture",
    "test:visual:strict": "node scripts/designsystem-visual.js --strict-pixels",
    "visual:update": "node scripts/designsystem-visual.js --update",
    "format:js": "node scripts/format-js.js --write",
    "format:check": "node scripts/format-js.js",
    "check:jsdoc": "node scripts/check-jsdoc.js && node scripts/check-jsdoc-complete.js && node scripts/check-js-types.js",
    "check:jsdoc:all": "node scripts/check-js-types.js",
    "format:css": "node scripts/format-css.js --write",
    "format:css:check": "node scripts/format-css.js",
    "format:html": "node scripts/format-html-templates.js --write",
    "format:html:check": "node scripts/format-html-templates.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "html5-qrcode": "2.3.8",
    "three": "0.187.0"
  },
  "devDependencies": {
    "@types/node": "22.15.33",
    "playwright-core": "1.65.1",
    "typescript": "5.8.3"
  }
}

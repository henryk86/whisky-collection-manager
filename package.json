{
  "name": "whisky-collection-manager",
  "version": "0.17.15",
  "private": true,
  "description": "Lokale Whisky-Sammlungsverwaltung mit JSON-Datenspeicherung",
  "type": "module",
  "scripts": {
    "start": "node scripts/start.js",
    "dev": "node --watch server/index.js",
    "https:setup": "node scripts/setup-https.js",
    "test": "node scripts/test.js",
    "test:browser": "node scripts/test.js --browser",
    "check": "node scripts/check.js",
    "verify": "npm run check && npm test",
    "release:check": "node scripts/release-version.js check",
    "release:sync": "node scripts/release-version.js sync",
    "release:bump": "node scripts/release-version.js bump",
    "cutout:prepare": "node scripts/prepare-cutout-assets.js",
    "cutout:verify": "node scripts/prepare-cutout-assets.js --verify"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "dependencies": {
    "html5-qrcode": "2.3.8",
    "three": "0.187.0"
  },
  "devDependencies": {
    "playwright-core": "1.65.0"
  }
}
